{
  "title": "mailreportd",
  "uid": "mailreportd",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "mailreportd"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mailreport_dmarc_messages, tenant)",
          "refId": "tenant"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mailreport_dmarc_messages{tenant=~\"$tenant\"}, domain)",
          "refId": "domain"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DMARC pass ratio by domain",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - ((sum by (domain) (mailreport_dmarc_messages{tenant=~\"$tenant\", domain=~\"$domain\", dkim!=\"pass\", spf!=\"pass\"}) / sum by (domain) (mailreport_dmarc_messages{tenant=~\"$tenant\", domain=~\"$domain\"})) or (sum by (domain) (mailreport_dmarc_messages{tenant=~\"$tenant\", domain=~\"$domain\"}) * 0))",
          "legendFormat": "{{domain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Messages by source_class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source_class) (mailreport_dmarc_messages{tenant=~\"$tenant\", domain=~\"$domain\"})",
          "legendFormat": "{{source_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Failing by reporter",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reporter) (mailreport_dmarc_messages{tenant=~\"$tenant\", domain=~\"$domain\", dkim!=\"pass\", spf!=\"pass\"})",
          "legendFormat": "{{reporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "TLS-RPT sessions by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (mailreport_tlsrpt_sessions{tenant=~\"$tenant\", domain=~\"$domain\"})",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "TLS failures by result_type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result_type) (mailreport_tlsrpt_failures{tenant=~\"$tenant\", domain=~\"$domain\"})",
          "legendFormat": "{{result_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Report freshness (age)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - mailreport_report_last_received_timestamp_seconds{tenant=~\"$tenant\", domain=~\"$domain\"}",
          "legendFormat": "{{domain}} {{format}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Policy health",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_dkim_record_state{tenant=~\"$tenant\", domain=~\"$domain\"} == 1",
          "legendFormat": "DKIM state",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_spf_lookups{tenant=~\"$tenant\", domain=~\"$domain\"}",
          "legendFormat": "SPF lookups",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_dmarc_record_policy{tenant=~\"$tenant\", domain=~\"$domain\"} == 1",
          "legendFormat": "DMARC policy",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_dmarc_record_pct{tenant=~\"$tenant\", domain=~\"$domain\"}",
          "legendFormat": "DMARC pct",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_mtasts_policy{tenant=~\"$tenant\", domain=~\"$domain\"} == 1",
          "legendFormat": "MTA-STS mode",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mailreport_mtasts_mx_covered{tenant=~\"$tenant\", domain=~\"$domain\"}",
          "legendFormat": "MX covered",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ]
}